{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@dcloudio/types"],
    // wot-ui 库源码仍有 11 处 type-only 值导入（2.4.0 仅部分改为 import type），继承的 importsNotUsedAsValues:error 会报 TS1371，项目层放宽为默认值；上游清零后可撤
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
