# 生产环境配置（build:* 命令自动加载）
# 小程序/App 直连：上线必须是 HTTPS 备案域名（Android 9+ 禁明文 HTTP）
VITE_APP_BASE_URL = https://api.example.com
# H5 生产域名：与后端同域部署时可填 '/' 走 nginx 反代，否则填完整域名
VITE_APP_H5_PROD_URL = https://api.example.com

# ===== 地图密钥（上线前填生产密钥：H5 JS API key 需在高德控制台配域名白名单；小程序 key 需配对应上线版本）=====
VITE_AMAP_WEB_KEY =
VITE_AMAP_SECURITY_CODE =
VITE_QQ_MAP_KEY =
VITE_AMAP_MP_KEY =

# ===== 鉴权与接口加密（上线前填生产值：密钥对须与后端 api-decrypt 同步更换；留空则登录与加密接口不可用）=====
VITE_CLIENT_ID =
VITE_RSA_PUBLIC_KEY =
VITE_RSA_PRIVATE_KEY =

# ===== 多实例部署隔离（同域部署多套时避免 token/主题互相覆盖）=====
# 存储 key 前缀：每套独立构建时在此填实例 ID（如 instance-a）；留空则 H5 按访问路径一级目录自动推导，根目录部署无前缀
VITE_STORAGE_PREFIX =
