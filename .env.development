# 开发环境配置（dev:* 命令自动加载）
# 小程序/App 直连后端地址：本机开发者工具用 localhost；真机调试改成后端机器的局域网 IP
VITE_APP_BASE_URL = http://127.0.0.1:8080
# H5 生产域名（仅 build:h5 时使用，开发期走 /dev-api 代理，此值不生效）
VITE_APP_H5_PROD_URL = https://api.example.com

# ===== 地图密钥（统一管理；消费方见 src/config/index.ts 与 src/api/map.ts）=====
